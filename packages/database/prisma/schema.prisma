// =============================================================================
// School Management System - Prisma Schema
// Foundation schema (Section 4 of specification)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

model School {
  id          String   @id @default(uuid())
  name        String
  address     String
  phone       String
  logoUrl     String?
  createdAt   DateTime @default(now())
  users       User[]
  classes     Class[]
  notices     Notice[]
}

model User {
  id            String   @id @default(uuid())
  phone         String   @unique
  name          String
  role          Role
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  // Role-specific relations
  teacherProfile  Teacher?
  studentProfile  Student?
  parentProfile   Parent?
}

model Teacher {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  subjects     TeacherSubjectClass[]
}

model Parent {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  students     Student[]
}

model Student {
  id            String   @id @default(uuid())
  userId        String?  @unique
  user          User?    @relation(fields: [userId], references: [id])
  name          String
  rollNumber    String
  dateOfBirth   DateTime
  classId       String
  class         Class    @relation(fields: [classId], references: [id])
  parentId      String?
  parent        Parent?  @relation(fields: [parentId], references: [id])
  attendance    Attendance[]
  marks         Mark[]
  createdAt     DateTime @default(now())
}

model Class {
  id          String   @id @default(uuid())
  name        String   // e.g. "Class 10"
  section     String   // e.g. "A"
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  students    Student[]
  subjects    TeacherSubjectClass[]
  homeworks   Homework[]
  exams       Exam[]
}

model Subject {
  id        String   @id @default(uuid())
  name      String
  mappings  TeacherSubjectClass[]
}

model TeacherSubjectClass {
  id          String   @id @default(uuid())
  teacherId   String
  teacher     Teacher  @relation(fields: [teacherId], references: [id])
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id])
  classId     String
  class       Class    @relation(fields: [classId], references: [id])
}

model Attendance {
  id          String   @id @default(uuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  date        DateTime
  status      AttendanceStatus
  markedBy    String   // teacherId
  createdAt   DateTime @default(now())

  @@unique([studentId, date])
}

model Homework {
  id          String   @id @default(uuid())
  classId     String
  class       Class    @relation(fields: [classId], references: [id])
  subjectId   String
  teacherId   String
  title       String
  description String
  attachmentUrl String?
  dueDate     DateTime
  createdAt   DateTime @default(now())
}

model Notice {
  id          String   @id @default(uuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  title       String
  content     String
  targetRole  Role?    // null = everyone
  targetClassId String?
  createdAt   DateTime @default(now())
  sendSms     Boolean  @default(false)
}

model Exam {
  id          String   @id @default(uuid())
  name        String   // e.g. "First Terminal Exam"
  classId     String
  class       Class    @relation(fields: [classId], references: [id])
  marks       Mark[]
  createdAt   DateTime @default(now())
}

model Mark {
  id          String   @id @default(uuid())
  examId      String
  exam        Exam     @relation(fields: [examId], references: [id])
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  subjectId   String
  score       Float
  fullMarks   Float
  grade       String?  // calculated: A+, A, B+, etc.
}

model Message {
  id          String   @id @default(uuid())
  senderId    String
  receiverId  String
  content     String
  createdAt   DateTime @default(now())
  readAt      DateTime?
}

// =============================================================================
// SMS Message Templates (Section 8 - configurable templates)
// =============================================================================

model MessageTemplate {
  id        String   @id @default(uuid())
  key       String   @unique // e.g. ABSENCE_ALERT_EN
  locale    String   // "en" | "ne"
  title     String?
  body      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
