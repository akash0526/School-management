# =============================================================================
# Backend Environment Variables (Render)
# Copy to .env before deploying
# =============================================================================

# --- Database (Supabase PostgreSQL) ---
DATABASE_URL="postgresql://postgres:password@db.xxx.supabase.co:5432/postgres"
# Use the Supabase "Connection string > Transaction mode" or "Pooler" URL

# --- JWT Authentication ---
JWT_ACCESS_SECRET=your-access-token-secret-change-me
JWT_REFRESH_SECRET=your-refresh-token-secret-change-me
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Server ---
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://your-frontend.vercel.app

# --- SMS Gateway (Sparrow SMS - Nepal) ---
SPARROW_SMS_API_KEY=your-sparrow-sms-api-key
SPARROW_SMS_SENDER_ID=SCHOOL
SMS_MOCK_MODE=false
